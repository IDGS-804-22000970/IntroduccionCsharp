@model introCsharp.Models.CalcularDis

@{
    ViewBag.Title = "CalcularDis";
}

<h2>Calcular Distancia Entre Dos Puntos</h2>

<div class="row">

    <div class="col-lg-6">

        <form method="post">

            <label for="X1">X1:</label>
            <input type="text" name="X1" value="" />
            <br />

            <label for="Y1">Y1:</label>
            <input type="text" name="Y1" value="" />
            <br />

            <label for="X2">X2:</label>
            <input type="text" name="X2" value="" />
            <br />

            <label for="Y2">Y2:</label>
            <input type="text" name="Y2" value="" />
            <br />
            <br />

            <input type="submit" value="Calcular" />

        </form>

    </div>

    <div class="col-lg-6">

        <br />

        <h1>
            La distancia es:

            @Html.DisplayFor(model => model.Res)
        </h1>

    </div>

</div>